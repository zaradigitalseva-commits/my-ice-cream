// MY ICE CREAM — Cloud Firestore security rules
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "zaradigitalseva@gmail.com",
          "ngogrant454@gmail.com"
        ];
    }

    function ownsShop(shopId) {
      return signedIn()
        && get(/databases/$(database)/documents/shops/$(shopId))
          .data.ownerUid == request.auth.uid;
    }

    function validSubscription(shopData) {
      return shopData.subscriptionStatus == "active"
        && shopData.subscriptionExpiresAt is timestamp
        && request.time < shopData.subscriptionExpiresAt;
    }

    function liveShop(shopId) {
      let shop = get(/databases/$(database)/documents/shops/$(shopId)).data;
      return shop.status == "live" && validSubscription(shop);
    }

    function validProduct(data, shopId) {
      return data.shopId == shopId
        && data.ownerUid == request.auth.uid
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.price is number
        && data.price >= 0
        && data.stock is int
        && data.stock >= 0
        && data.active is bool
        && data.category is string
        && data.description is string
        && data.imageUrl is string
        && (!("originalPrice" in data)
          || data.originalPrice == null
          || (data.originalPrice is number && data.originalPrice >= data.price));
    }

    function customerStockReservation(shopId, productId) {
      let orderPath =
        /databases/$(database)/documents/orders/$(request.resource.data.lastOrderId);

      return signedIn()
        && request.resource.data.lastOrderId is string
        && !exists(orderPath)
        && getAfter(orderPath).data.customerUid == request.auth.uid
        && getAfter(orderPath).data.shopId == shopId
        && getAfter(orderPath).data.status == "placed"
        && getAfter(orderPath).data.stockChanges[productId]
          == resource.data.stock - request.resource.data.stock
        && request.resource.data.stock >= 0
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["stock", "lastOrderId", "updatedAt"]);
    }

    function customerStockRestore(shopId, productId) {
      let orderPath = /databases/$(database)/documents/orders/$(request.resource.data.lastCancelledOrderId);
      return signedIn()
        && request.resource.data.lastCancelledOrderId is string
        && exists(orderPath)
        && getAfter(orderPath).data.customerUid == request.auth.uid
        && getAfter(orderPath).data.shopId == shopId
        && getAfter(orderPath).data.status == "cancelled"
        && getAfter(orderPath).data.stockChanges[productId] is number
        && request.resource.data.stock
          == resource.data.stock + getAfter(orderPath).data.stockChanges[productId]
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["stock", "lastCancelledOrderId", "updatedAt"]);
    }

    match /shops/{shopId} {

      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (resource.data.status == "live" && validSubscription(resource.data));

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "pending"
        && getAfter(
          /databases/$(database)/documents/shopOwnerLocks/$(request.auth.uid)
        ).data.shopId == shopId;

      allow update: if (isAdmin()
          && (request.resource.data.status != "live" || validSubscription(request.resource.data)))
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "shopName", "phone", "city", "address",
            "description", "logoUrl", "bannerUrl", "category",
            "pickupAvailable", "deliveryAvailable",
            "openingTime", "closingTime", "closedDays",
            "manualClosed", "deliveryFee", "minimumOrder",
            "offerTitle", "offerDescription", "offerExpiresAt",
            "updatedAt"
          ])
        );

      allow delete: if isAdmin();

      match /products/{productId} {

        allow read: if isAdmin()
          || ownsShop(shopId)
          || (liveShop(shopId) && resource.data.active == true);

        allow create: if isAdmin()
          || (
            ownsShop(shopId)
            && liveShop(shopId)
            && validProduct(request.resource.data, shopId)
          );

        allow update: if isAdmin()
          || (
            ownsShop(shopId)
            && liveShop(shopId)
            && resource.data.shopId == shopId
            && validProduct(request.resource.data, shopId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "name", "description", "price", "originalPrice", "category",
              "stock", "imageUrl", "active", "updatedAt"
            ])
          )
          || (
            liveShop(shopId)
            && customerStockReservation(shopId, productId)
          )
          || customerStockRestore(shopId, productId);

        allow delete: if isAdmin()
          || (
            ownsShop(shopId)
            && liveShop(shopId)
            && resource.data.ownerUid == request.auth.uid
          );
      }
    }

    match /customers/{phoneNumber} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (signedIn()
          && !exists(/databases/$(database)/documents/customers/$(phoneNumber))
          && exists(/databases/$(database)/documents/shopOwnerLocks/$(request.auth.uid)))
        || (signedIn()
          && resource.data.createdByShopId is string
          && ownsShop(resource.data.createdByShopId));
      allow list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && phoneNumber.matches('^[0-9]{10}$')
        && request.resource.data.phone == phoneNumber
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (
          (request.resource.data.uid == request.auth.uid
            && !exists(/databases/$(database)/documents/customers/$(phoneNumber)))
          || (request.resource.data.uid == ""
            && request.resource.data.registered == false
            && request.resource.data.createdByShopId is string
            && ownsShop(request.resource.data.createdByShopId)
            && exists(/databases/$(database)/documents/shopOwnerLocks/$(request.auth.uid)))
        );
      allow update: if signedIn()
        && request.resource.data.phone == resource.data.phone
        && (
          (resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["name", "email", "updatedAt", "registered"]))
          || (resource.data.uid == ""
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.registered == true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["uid", "name", "email", "registered", "updatedAt"]))
        );
      allow delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid)
        || (signedIn() && resource.data.ownerUid == request.auth.uid
          && ownsShop(resource.data.shopId));
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.shopId is string
        && ownsShop(request.resource.data.shopId)
        && request.resource.data.customerPhone is string
        && request.resource.data.customerUid
          == get(/databases/$(database)/documents/customers/$(request.resource.data.customerPhone)).data.uid
        && request.resource.data.shopName is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.discount is number
        && request.resource.data.paymentStatus in ["paid", "unpaid"];
      allow update: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid
          && ownsShop(resource.data.shopId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["paymentStatus", "updatedAt"])
          && request.resource.data.paymentStatus in ["paid", "unpaid"]);
      allow delete: if isAdmin();
    }

    match /shopOwnerLocks/{ownerUid} {
      allow read: if signedIn() && request.auth.uid == ownerUid;
      allow create: if signedIn()
        && request.auth.uid == ownerUid
        && !exists(/databases/$(database)/documents/shopOwnerLocks/$(ownerUid))
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.shopId is string;
      allow update, delete: if false;
    }

    function reservedOrderItem(orderData, index, orderId) {
      let item = orderData.items[index];
      let productPath = /databases/$(database)/documents/shops/$(orderData.shopId)/products/$(item.productId);
      return item.productId is string
        && item.quantity is int
        && item.quantity > 0
        && orderData.stockChanges[item.productId] == item.quantity
        && exists(productPath)
        && getAfter(productPath).data.lastOrderId == orderId;
    }

    function allOrderItemsReserved(orderData, orderId) {
      return orderData.items is list
        && orderData.items.size() > 0
        && orderData.items.size() <= 10
        && reservedOrderItem(orderData, 0, orderId)
        && (orderData.items.size() < 2 || reservedOrderItem(orderData, 1, orderId))
        && (orderData.items.size() < 3 || reservedOrderItem(orderData, 2, orderId))
        && (orderData.items.size() < 4 || reservedOrderItem(orderData, 3, orderId))
        && (orderData.items.size() < 5 || reservedOrderItem(orderData, 4, orderId))
        && (orderData.items.size() < 6 || reservedOrderItem(orderData, 5, orderId))
        && (orderData.items.size() < 7 || reservedOrderItem(orderData, 6, orderId))
        && (orderData.items.size() < 8 || reservedOrderItem(orderData, 7, orderId))
        && (orderData.items.size() < 9 || reservedOrderItem(orderData, 8, orderId))
        && (orderData.items.size() < 10 || reservedOrderItem(orderData, 9, orderId));
    }
    function restoredOrderItem(orderData, index, orderId) {
      let item = orderData.items[index];
      let productPath = /databases/$(database)/documents/shops/$(orderData.shopId)/products/$(item.productId);
      return item.productId is string
        && item.quantity is int
        && item.quantity > 0
        && orderData.stockChanges[item.productId] == item.quantity
        && exists(productPath)
        && getAfter(productPath).data.lastCancelledOrderId == orderId;
    }

    function allOrderItemsRestored(orderData, orderId) {
      return orderData.items is list
        && orderData.items.size() > 0
        && orderData.items.size() <= 10
        && restoredOrderItem(orderData, 0, orderId)
        && (orderData.items.size() < 2 || restoredOrderItem(orderData, 1, orderId))
        && (orderData.items.size() < 3 || restoredOrderItem(orderData, 2, orderId))
        && (orderData.items.size() < 4 || restoredOrderItem(orderData, 3, orderId))
        && (orderData.items.size() < 5 || restoredOrderItem(orderData, 4, orderId))
        && (orderData.items.size() < 6 || restoredOrderItem(orderData, 5, orderId))
        && (orderData.items.size() < 7 || restoredOrderItem(orderData, 6, orderId))
        && (orderData.items.size() < 8 || restoredOrderItem(orderData, 7, orderId))
        && (orderData.items.size() < 9 || restoredOrderItem(orderData, 8, orderId))
        && (orderData.items.size() < 10 || restoredOrderItem(orderData, 9, orderId));
    }

    match /orders/{orderId} {

      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "placed"
        && request.resource.data.paymentStatus == "unpaid"
        && request.resource.data.shopId is string
        && liveShop(request.resource.data.shopId)
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 10
        && request.resource.data.stockChanges is map
        && request.resource.data.stockChanges.keys().size() == request.resource.data.items.size()
        && allOrderItemsReserved(request.resource.data, orderId);

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.customerUid == request.auth.uid
        )
        || (
          signedIn()
          && ownsShop(resource.data.shopId)
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && ownsShop(resource.data.shopId)
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.shopId == resource.data.shopId
          && (
            (resource.data.status == "placed" && request.resource.data.status == "accepted")
            || (resource.data.status == "accepted" && request.resource.data.status == "preparing")
            || (resource.data.status == "preparing" && request.resource.data.status == "ready")
            || (resource.data.status == "ready" && request.resource.data.status == "completed")
          )
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["status", "updatedAt"])
        )
        || (
          signedIn()
          && ownsShop(resource.data.shopId)
          && resource.data.status != "cancelled"
          && resource.data.paymentStatus == "unpaid"
          && request.resource.data.paymentStatus == "paid"
          && request.resource.data.status == resource.data.status
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["paymentStatus", "updatedAt"])
        )
        || (
          signedIn()
          && resource.data.customerUid == request.auth.uid
          && resource.data.status == "placed"
          && resource.data.paymentStatus == "unpaid"
          && request.resource.data.status == "cancelled"
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["status", "updatedAt"])
          && allOrderItemsRestored(resource.data, orderId)
        );

      allow delete: if isAdmin();
    }

    match /subscriptionPayments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.shopId is string
        && ownsShop(request.resource.data.shopId)
        && request.resource.data.status == "pending"
        && request.resource.data.amount == 299
        && request.resource.data.utr is string
        && request.resource.data.utr.matches('^[A-Z0-9]{6,40}$')
        && getAfter(/databases/$(database)/documents/utrReservations/$(request.resource.data.utr)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/utrReservations/$(request.resource.data.utr)).data.shopId == request.resource.data.shopId
        && getAfter(/databases/$(database)/documents/utrReservations/$(request.resource.data.utr)).data.paymentId == paymentId;
      allow update, delete: if isAdmin();
    }

    match /utrReservations/{utr} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/utrReservations/$(utr))
        && utr.matches('^[A-Z0-9]{6,40}$')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.shopId is string
        && ownsShop(request.resource.data.shopId)
        && request.resource.data.paymentId is string
        && request.resource.data.keys().hasOnly(["ownerUid", "shopId", "paymentId", "createdAt"]);
      allow update, delete: if false;
    }

    match /siteSettings/{settingId} {
      allow read: if settingId == "branding";
      allow write: if isAdmin() && settingId == "branding";
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
