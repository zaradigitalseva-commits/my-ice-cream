rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ["zaradigitalseva@gmail.com", "ngogrant454@gmail.com"];
    }
    function ownsShop(shopId) {
      return signedIn()
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;
    }
    function liveShop(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data.status == "live";
    }

    match /shops/{shopId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || resource.data.status == "live";
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "shopName", "phone", "city", "address", "description",
            "logoUrl", "bannerUrl", "category", "updatedAt"
          ]));
      allow delete: if isAdmin();

      match /products/{productId} {
        allow read: if isAdmin() || (liveShop(shopId) && resource.data.active == true)
          || (ownsShop(shopId) && !liveShop(shopId));
        allow create: if isAdmin() || (ownsShop(shopId) && liveShop(shopId)
          && request.resource.data.shopId == shopId
          && request.resource.data.ownerUid == request.auth.uid);
        allow update: if isAdmin() || (ownsShop(shopId) && liveShop(shopId)
          && resource.data.shopId == shopId
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.ownerUid == request.auth.uid);
        allow delete: if isAdmin() || (ownsShop(shopId) && liveShop(shopId)
          && resource.data.ownerUid == request.auth.uid);
      }
    }

    match /subscriptionPayments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}