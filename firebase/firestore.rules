rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin identity helper. Firebase Auth must provide a verified email.
    // Keep data access closed until collection-specific permissions are added.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "zaradigitalseva@gmail.com",
          "ngogrant454@gmail.com"
        ];
    }

    // Safe baseline: no client access until collection ownership and
    // role-specific authorization rules have been implemented and reviewed.
    // Use isAdmin() in the relevant collection rules when those are added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
