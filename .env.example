# Copy this file to .env.local on your own computer.
# Fill values from Firebase Console > Project settings > Your apps > MY ICE CREAM WEB.
# Never commit .env.local. It is ignored by .gitignore.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Console > Project settings > Cloud Messaging > Web Push certificates.
# Public key only; safe to expose to browsers.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server-only secret: full Firebase service-account JSON. Never add to NEXT_PUBLIC_* or Git.
# Configure this as FCM_SERVICE_ACCOUNT_JSON in the hosting provider's secret settings.
